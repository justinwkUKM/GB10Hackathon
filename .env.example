# ---- Target under test ----
# The authorized target endpoint (set by the sandbox automatically for demo runs).
TARGET_URL=http://localhost:7014/v1/chat/completions
# Comma-separated allowlist of target IDs/hosts this run is authorized to attack.
SCOPE_ALLOWLIST=demo-target,localhost

# ---- Attack budget (runaway protection) ----
BUDGET_SEND_TO_TARGET=40
BUDGET_RUN_GARAK=6
BUDGET_RECORD_FINDING=50

# ---- Brain / attacker model (OpenAI-compatible, local-first) ----
# Pi resolves this from models.json via ModelRuntime.getModel(BRAIN_PROVIDER, BRAIN_MODEL).
BRAIN_PROVIDER=local
BRAIN_MODEL=nemotron-3.5-lightning
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
BRAIN_THINKING_LEVEL=high

# ---- Judge model (fuzzy cases only; direct OpenAI-compatible call) ----
# Leave JUDGE_BASE_URL empty to disable the judge (hard verifiers still run).
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# ---- Workdir ----
# Scratch dir for captures, canaries, transcript (the harness already runs inside
# a no-egress sandbox provided by the environment; it does not create one).
HARNESS_WORKDIR=.pi-agent/workdir
